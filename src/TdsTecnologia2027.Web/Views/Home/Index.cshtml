@model IEnumerable<TdsTecnologia2027.Web.Models.Curso>
@using System.Globalization
@{
    Layout = null;

    // Número padrão do WhatsApp do consultor (formato wa.me sem o "+").
    const string telefoneWhatsApp = "5565993541604";

    string LinkWhats(string? mensagem)
    {
        var texto = string.IsNullOrWhiteSpace(mensagem)
            ? "Olá, quero saber mais sobre os cursos da TDS Tecnologia!"
            : mensagem;
        return $"https://wa.me/{telefoneWhatsApp}?text={Uri.EscapeDataString(texto)}";
    }

    string FormatarData(DateTime? data)
    {
        if (!data.HasValue) return string.Empty;
        var pt = new CultureInfo("pt-BR");
        // Ex: "21/Mai"
        return data.Value.ToString("dd/MMM", pt).TrimEnd('.');
    }

    IEnumerable<string> Bullets(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw)) yield break;
        foreach (var linha in raw.Split('\n', StringSplitOptions.RemoveEmptyEntries))
        {
            var t = linha.Trim();
            if (t.Length > 0) yield return t;
        }
    }
}
