<style>
    .tds-wa-fab{position:fixed;right:20px;bottom:20px;z-index:2147483000;display:flex;align-items:center;height:60px;max-width:60px;border-radius:30px;background:#25d366;color:#fff;text-decoration:none;box-shadow:0 8px 24px rgba(0,0,0,.28);overflow:hidden;font-family:Inter,-apple-system,"Segoe UI",Arial,sans-serif;transition:max-width .35s cubic-bezier(.2,.7,.3,1),transform .25s;animation:tds-wa-pulse 2.6s ease-out infinite}
    .tds-wa-fab__ico{flex:0 0 60px;display:flex;align-items:center;justify-content:center}
    .tds-wa-fab__ico svg{width:34px;height:34px;fill:#fff}
    .tds-wa-fab__label{white-space:nowrap;font-weight:600;font-size:15px;padding-right:24px;opacity:0;transition:opacity .25s .05s}
    .tds-wa-fab:hover,.tds-wa-fab:focus-visible{max-width:320px;transform:translateY(-2px)}
    .tds-wa-fab:hover .tds-wa-fab__label,.tds-wa-fab:focus-visible .tds-wa-fab__label{opacity:1}
    @@keyframes tds-wa-pulse{0%{box-shadow:0 8px 24px rgba(0,0,0,.28),0 0 0 0 rgba(37,211,102,.55)}70%{box-shadow:0 8px 24px rgba(0,0,0,.28),0 0 0 16px rgba(37,211,102,0)}100%{box-shadow:0 8px 24px rgba(0,0,0,.28),0 0 0 0 rgba(37,211,102,0)}}
