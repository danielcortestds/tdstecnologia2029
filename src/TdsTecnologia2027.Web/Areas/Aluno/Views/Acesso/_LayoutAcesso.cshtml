<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Área do Aluno TDS</title>
    <link rel="icon" type="image/png" href="/favicon-32.png?v=2">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        :root { --tds-teal:#14b8a6; --tds-teal-dark:#0d9488; --tds-navy:#0b1220; --tds-panel:#0f172a; }
        body { background:radial-gradient(1200px 600px at 50% -10%, #122033 0%, var(--tds-navy) 60%); color:#e2e8f0;
               font-family:system-ui,-apple-system,"Segoe UI",Roboto,sans-serif; min-height:100vh;
               display:flex; align-items:center; justify-content:center; padding:24px; }
        .acesso-card { width:100%; max-width:420px; background:var(--tds-panel);
                       border:1px solid rgba(20,184,166,0.25); border-radius:18px; padding:32px;
                       box-shadow:0 20px 60px rgba(0,0,0,0.5); }
        .selo-aluno { display:inline-flex; align-items:center; gap:8px; background:rgba(20,184,166,0.12);
                      color:var(--tds-teal); border:1px solid rgba(20,184,166,0.4); font-weight:700;
                      font-size:.78rem; letter-spacing:.06em; text-transform:uppercase;
                      padding:6px 12px; border-radius:999px; }
        .acesso-card h1 { font-size:1.5rem; font-weight:800; margin:16px 0 4px; color:#fff; }
        .acesso-card .sub { color:#94a3b8; font-size:.95rem; margin-bottom:22px; }
        .form-label { color:#cbd5e1; font-weight:600; }
        .form-control { background:#0b1220; border:1px solid rgba(148,163,184,0.3); color:#e2e8f0; }
        .form-control:focus { background:#0b1220; color:#fff; border-color:var(--tds-teal);
                              box-shadow:0 0 0 .2rem rgba(20,184,166,0.25); }
        .btn-aluno { background:var(--tds-teal); border:none; color:#04201c; font-weight:800;
                     padding:11px; border-radius:10px; }
        .btn-aluno:hover { background:var(--tds-teal-dark); color:#fff; }
        a { color:var(--tds-teal); }
        .form-check-input:checked { background-color:var(--tds-teal); border-color:var(--tds-teal); }
        .text-danger { color:#fca5a5 !important; }
    </style>
</head>
<body>
    <div class="acesso-card">
        <div class="text-center mb-2">
            <img src="/images/logo-dark.png" alt="TDS Tecnologia" style="height:38px" />
        </div>
        @RenderBody()
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
