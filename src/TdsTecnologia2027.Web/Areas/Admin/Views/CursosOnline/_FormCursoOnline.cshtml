@model TdsTecnologia2027.Web.Models.CursoOnline
@using TdsTecnologia2027.Web.Models

<div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

<div class="row g-3">
    <div class="col-md-8">
        <label asp-for="Nome" class="form-label fw-semibold"></label>
        <input asp-for="Nome" class="form-control" />
        <span asp-validation-for="Nome" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Slug" class="form-label fw-semibold"></label>
        <input asp-for="Slug" class="form-control" placeholder="gerado automaticamente" />
        <div class="form-text">Deixe em branco para gerar pelo nome.</div>
    </div>

    <div class="col-12">
        <label asp-for="DescricaoCurta" class="form-label fw-semibold"></label>
        <input asp-for="DescricaoCurta" class="form-control" />
    </div>

    <div class="col-12">
        <label asp-for="DescricaoCompleta" class="form-label fw-semibold"></label>
        <textarea asp-for="DescricaoCompleta" class="form-control" rows="4"></textarea>
    </div>

    <div class="col-12">
        <label class="form-label fw-semibold">Capa do curso (cor + ícone)</label>
        <div class="d-flex align-items-center gap-3 flex-wrap">
            <div>
                <span class="d-block small text-muted mb-1">Cor de fundo</span>
                <input asp-for="CorCapa" type="color" class="form-control form-control-color" value="@(string.IsNullOrWhiteSpace(Model.CorCapa) ? "#0d9488" : Model.CorCapa)" id="corCapa" oninput="atualizarPreviaCapa()" />
            </div>
            <div style="min-width:220px;">
                <span class="d-block small text-muted mb-1">Ícone</span>
                <select asp-for="IconeCapa" class="form-select" id="iconeCapa" onchange="atualizarPreviaCapa()">
                    @{
                        var icones = new (string val, string nome)[]
                        {
                            ("bi-play-circle-fill","Vídeo / play"), ("bi-code-slash","Programação"),
                            ("bi-bar-chart-fill","Dados / BI"), ("bi-robot","IA / Robô"),
                            ("bi-database-fill","Banco de dados"), ("bi-cloud-fill","Cloud"),
                            ("bi-shield-lock-fill","Segurança / LGPD"), ("bi-diagram-3-fill","Arquitetura"),
                            ("bi-lightbulb-fill","Lógica / Ideia"), ("bi-mortarboard-fill","Formação"),
                            ("bi-graph-up-arrow","Análise"), ("bi-gear-fill","Ferramentas")
                        };
                    }
                    @foreach (var ic in icones)
                    {
                        <option value="@ic.val" selected="@(Model.IconeCapa == ic.val)">@ic.nome</option>
                    }
                </select>
            </div>
            <div>
                <span class="d-block small text-muted mb-1">Prévia</span>
                <div id="previaCapa" style="width:88px; height:64px; border-radius:10px; display:flex; align-items:center; justify-content:center;">
                    <i id="previaIcone" class="bi" style="font-size:28px; color:#fff;"></i>
                </div>
            </div>
        </div>
        <div class="form-text">A capa usa cor + ícone (sem precisar de imagem). Imagem é opcional, abaixo.</div>
    </div>

    <div class="col-md-6">
        <label asp-for="ImagemCapa" class="form-label fw-semibold"></label>
        <input asp-for="ImagemCapa" class="form-control" placeholder="opcional — deixe em branco para usar a cor + ícone" />
    </div>
    <div class="col-md-3">
        <label asp-for="Categoria" class="form-label fw-semibold"></label>
        <input asp-for="Categoria" class="form-control" />
    </div>
    <div class="col-md-3">
        <label asp-for="Instrutor" class="form-label fw-semibold"></label>
        <input asp-for="Instrutor" class="form-control" />
    </div>

    <div class="col-md-3">
        <label asp-for="Status" class="form-label fw-semibold"></label>
        <select asp-for="Status" class="form-select"
                asp-items="Html.GetEnumSelectList<StatusCursoOnline>()"></select>
    </div>
    <div class="col-md-3">
        <label asp-for="CargaHoraria" class="form-label fw-semibold"></label>
        <input asp-for="CargaHoraria" type="number" min="0" class="form-control" />
    </div>
    <div class="col-md-3">
        <label asp-for="Ordem" class="form-label fw-semibold"></label>
        <input asp-for="Ordem" type="number" class="form-control" />
    </div>
    <div class="col-md-3 d-flex align-items-end">
        <div class="form-check form-switch mb-2">
            <input asp-for="Certificado" class="form-check-input" role="switch" />
            <label asp-for="Certificado" class="form-check-label"></label>
        </div>
    </div>
</div>

<script>
    function atualizarPreviaCapa() {
        var cor = document.getElementById('corCapa').value || '#0d9488';
        var icone = document.getElementById('iconeCapa').value || 'bi-play-circle-fill';
        document.getElementById('previaCapa').style.background = cor;
        document.getElementById('previaIcone').className = 'bi ' + icone;
    }
    atualizarPreviaCapa();
</script>
