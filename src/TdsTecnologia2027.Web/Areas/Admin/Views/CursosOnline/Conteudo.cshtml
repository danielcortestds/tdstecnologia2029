@model TdsTecnologia2027.Web.Models.CursoOnline
@{ ViewData["Title"] = "Conteúdo — " + Model.Nome; }

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="mb-1"><i class="bi bi-list-ul me-2"></i>Módulos e aulas</h3>
        <p class="text-muted mb-0">@Model.Nome</p>
    </div>
    <div>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-secondary"><i class="bi bi-gear me-1"></i>Dados do curso</a>
        <a asp-action="Index" class="btn btn-outline-secondary">Voltar</a>
    </div>
</div>

<!-- Adicionar módulo -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-body">
        <form asp-action="AddModulo" method="post" class="row g-2 align-items-end">
            <input type="hidden" name="cursoId" value="@Model.Id" />
            <div class="col-md-9">
                <label class="form-label fw-semibold mb-1">Novo módulo</label>
                <input name="titulo" class="form-control" placeholder="Ex.: Módulo 1 — Introdução" required />
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-primary w-100"><i class="bi bi-plus-lg me-1"></i>Adicionar módulo</button>
            </div>
        </form>
    </div>
</div>

@if (!Model.Modulos.Any())
{
    <div class="alert alert-info">Este curso ainda não tem módulos. Adicione o primeiro acima.</div>
}

@foreach (var modulo in Model.Modulos.OrderBy(m => m.Ordem))
{
    <div class="card shadow-sm border-0 mb-3">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <span class="fw-semibold"><i class="bi bi-collection me-1 text-muted"></i>@modulo.Titulo
                <span class="badge bg-light text-muted ms-1">ordem @modulo.Ordem</span></span>
            <div>
                <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#mod-@modulo.Id"><i class="bi bi-pencil"></i></button>
                <form asp-action="DeleteModulo" asp-route-id="@modulo.Id" method="post" class="d-inline"
                      onsubmit="return confirm('Excluir o módulo @modulo.Titulo e suas aulas?');">
                    <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                </form>
            </div>
        </div>

        <!-- editar módulo (colapsável) -->
        <div class="collapse" id="mod-@modulo.Id">
            <div class="card-body border-bottom bg-light">
                <form asp-action="EditModulo" asp-route-id="@modulo.Id" method="post" class="row g-2 align-items-end">
                    <div class="col-md-8">
                        <label class="form-label small mb-1">Título</label>
                        <input name="titulo" value="@modulo.Titulo" class="form-control" required />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small mb-1">Ordem</label>
                        <input name="ordem" type="number" value="@modulo.Ordem" class="form-control" />
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-primary w-100">Salvar</button>
                    </div>
                </form>
            </div>
        </div>

        <ul class="list-group list-group-flush">
            @foreach (var licao in modulo.Licoes.OrderBy(l => l.Ordem))
            {
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    <span>
                        <i class="bi bi-play-circle me-2 text-primary"></i>@licao.Titulo
                        <span class="text-muted small ms-2">@licao.Duracao min</span>
                    </span>
                    <span>
                        <a asp-action="Licao" asp-route-id="@licao.Id" class="btn btn-sm btn-outline-secondary"><i class="bi bi-pencil"></i></a>
                        <form asp-action="DeleteLicao" asp-route-id="@licao.Id" method="post" class="d-inline"
                              onsubmit="return confirm('Excluir a aula @licao.Titulo?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                        </form>
                    </span>
                </li>
            }
            @if (!modulo.Licoes.Any())
            {
                <li class="list-group-item text-muted small">Nenhuma aula neste módulo ainda.</li>
            }
            <li class="list-group-item">
                <a asp-action="Licao" asp-route-moduloId="@modulo.Id" class="btn btn-sm btn-primary">
                    <i class="bi bi-plus-lg me-1"></i>Adicionar aula
                </a>
            </li>
        </ul>
    </div>
}
