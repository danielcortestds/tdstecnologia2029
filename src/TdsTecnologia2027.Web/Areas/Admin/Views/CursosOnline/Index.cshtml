@model List<TdsTecnologia2027.Web.Models.CursoOnline>
@using TdsTecnologia2027.Web.Models
@{ ViewData["Title"] = "Cursos Online"; }

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="mb-1"><i class="bi bi-collection-play me-2"></i>Cursos Online</h3>
        <p class="text-muted mb-0">Cursos em vídeo da Área do Aluno (separados dos cursos presenciais).</p>
    </div>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Novo curso online</a>
</div>

<div class="card shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Curso</th>
                    <th>Categoria</th>
                    <th>Instrutor</th>
                    <th>Conteúdo</th>
                    <th>Status</th>
                    <th class="text-end">Ações</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="6" class="text-center py-4 text-muted">Nenhum curso online cadastrado ainda.</td></tr>
                }
                @foreach (var c in Model)
                {
                    var aulas = c.Modulos.Sum(m => m.Licoes?.Count ?? 0);
                    <tr>
                        <td class="fw-semibold">@c.Nome<br><code class="small text-muted">@c.Slug</code></td>
                        <td class="small text-muted">@c.Categoria</td>
                        <td class="small text-muted">@c.Instrutor</td>
                        <td class="small">@c.Modulos.Count módulo(s)</td>
                        <td>
                            @switch (c.Status)
                            {
                                case StatusCursoOnline.Publicado:
                                    <span class="badge bg-success">Publicado</span>; break;
                                case StatusCursoOnline.Oculto:
                                    <span class="badge bg-secondary">Oculto</span>; break;
                                default:
                                    <span class="badge bg-warning text-dark">Rascunho</span>; break;
                            }
                        </td>
                        <td class="text-end">
                            <a asp-action="Conteudo" asp-route-id="@c.Id" class="btn btn-sm btn-outline-primary" title="Módulos e aulas"><i class="bi bi-list-ul"></i></a>
                            <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-outline-secondary" title="Editar"><i class="bi bi-pencil"></i></a>
                            <form asp-action="Delete" asp-route-id="@c.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('Excluir o curso @c.Nome e todo o seu conteúdo?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Excluir"><i class="bi bi-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
