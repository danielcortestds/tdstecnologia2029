@model TdsTecnologia2027.Web.Models.ResgateViewModel
@{
    Layout = "_LayoutLoja";
    ViewData["Title"] = "Resgatar voucher";
}

<h1 style="font-size:1.4rem; margin-bottom:4px;"><i class="bi bi-ticket-perforated me-2" style="color:var(--tds-teal);"></i>Resgatar voucher</h1>
<p class="text-muted-2" style="margin-bottom:22px;">Informe o código do seu voucher e seus dados. O curso é liberado na hora.</p>

<form asp-action="Resgatar" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
    <div class="mb-3">
        <label asp-for="Codigo" class="form-label"></label>
        <input asp-for="Codigo" class="form-control" placeholder="TDS-XXXX-XXXX" style="text-transform:uppercase; letter-spacing:1px; font-weight:600;" />
        <span asp-validation-for="Codigo" class="text-danger small"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Nome" class="form-label"></label>
        <input asp-for="Nome" class="form-control" placeholder="Seu nome completo" />
        <span asp-validation-for="Nome" class="text-danger small"></span>
    </div>
    <div class="mb-4">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" class="form-control" placeholder="seu@email.com" />
        <span asp-validation-for="Email" class="text-danger small"></span>
        <div class="text-muted-2 small mt-1">O acesso será liberado para este e-mail.</div>
    </div>
    <button type="submit" class="btn btn-tds"><i class="bi bi-unlock-fill me-1"></i>Resgatar e liberar acesso</button>
    <div class="text-center mt-3"><a href="/" class="small">&larr; Voltar ao site</a></div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
