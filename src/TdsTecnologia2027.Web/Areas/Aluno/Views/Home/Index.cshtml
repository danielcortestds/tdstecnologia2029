@model List<TdsTecnologia2027.Web.Models.MeuCursoViewModel>
@{ ViewData["Title"] = "Meus Cursos"; }

<div class="mb-4">
    <h3 class="mb-1">Meus Cursos</h3>
    <p class="text-muted-2 mb-0">Continue de onde parou.</p>
</div>

@if (!Model.Any())
{
    <div class="card-tds p-5 text-center">
        <i class="bi bi-collection-play text-muted-2" style="font-size:42px;"></i>
        <p class="mt-3 mb-0 fs-5">Você ainda não tem cursos liberados.</p>
        <p class="text-muted-2">Assim que a TDS liberar um curso para você, ele aparecerá aqui.</p>
    </div>
}

<div class="row g-4">
    @foreach (var item in Model)
    {
        <div class="col-md-6 col-lg-4">
            <div class="card-tds h-100 overflow-hidden d-flex flex-column">
                @{
                    var corCapa = string.IsNullOrWhiteSpace(item.Curso.CorCapa) ? "#0d9488" : item.Curso.CorCapa;
                    var iconeCapa = string.IsNullOrWhiteSpace(item.Curso.IconeCapa) ? "bi-play-circle-fill" : item.Curso.IconeCapa;
                }
                <div style="aspect-ratio:16/9; background:@corCapa; overflow:hidden;">
                    @if (!string.IsNullOrWhiteSpace(item.Curso.ImagemCapa))
                    {
                        <img src="@item.Curso.ImagemCapa" alt="@item.Curso.Nome" style="width:100%; height:100%; object-fit:cover;">
                    }
                    else
                    {
                        <div class="d-flex align-items-center justify-content-center h-100"><i class="bi @iconeCapa" style="font-size:46px; color:#fff;"></i></div>
                    }
                </div>
                <div class="p-3 d-flex flex-column flex-grow-1">
                    <h6 class="fw-bold mb-1">@item.Curso.Nome</h6>
                    @if (!string.IsNullOrWhiteSpace(item.Curso.Instrutor))
                    {
                        <p class="text-muted-2 small mb-2"><i class="bi bi-person me-1"></i>@item.Curso.Instrutor</p>
                    }
                    <div class="mt-auto">
                        <div class="d-flex justify-content-between small text-muted-2 mb-1">
                            <span>@item.PercentualConcluido% concluído</span>
                        </div>
                        <div class="progress mb-3" style="height:7px;">
                            <div class="progress-bar" style="width:@item.PercentualConcluido%"></div>
                        </div>
                        <a class="btn btn-tds w-100"
                           asp-area="Aluno" asp-controller="Curso" asp-action="Assistir"
                           asp-route-id="@item.Curso.Id" asp-route-licao="@item.ContinuarLicaoId">
                            <i class="bi bi-play-fill me-1"></i>@(item.PercentualConcluido > 0 ? "Continuar" : "Começar")
                        </a>
                        @if (item.PercentualConcluido >= TdsTecnologia2027.Web.Models.Certificado.PercentualMinimo)
                        {
                            <form asp-area="Aluno" asp-controller="Certificado" asp-action="Emitir" asp-route-id="@item.Curso.Id" method="post" class="mt-2">
                                <button type="submit" class="btn btn-outline-light w-100 btn-sm"><i class="bi bi-patch-check me-1"></i>Certificado</button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>
