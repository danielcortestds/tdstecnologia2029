								<a href="/Aluno" style="color:#14b8a6; text-decoration:none;"><i class="fa-solid fa-user-graduate me-1"></i>Área do Aluno</a>
								<span class="mx-2 d-none d-md-inline" style="color:#334155;">|</span>
								<a href="/Voucher/Resgatar" style="color:#14b8a6; text-decoration:none;"><i class="fa-solid fa-ticket me-1"></i>Resgatar voucher</a>
							</div>
							<div class="col-md-6 text-center text-md-end">
								<div class="d-flex justify-content-center justify-content-md-end">
									<a href="#" class="social-icon si-small border-transparent h-bg-facebook" aria-label="Facebook"><i class="fa-brands fa-facebook-f"></i><i class="fa-brands fa-facebook-f"></i></a>
									<a href="#" class="social-icon si-small border-transparent h-bg-instagram" aria-label="Instagram"><i class="fa-brands fa-instagram"></i><i class="fa-brands fa-instagram"></i></a>
									<a href="https://wa.me/5565993541604" target="_blank" rel="noopener" class="social-icon si-small border-transparent h-bg-whatsapp" aria-label="WhatsApp"><i class="fa-brands fa-whatsapp"></i><i class="fa-brands fa-whatsapp"></i></a>
								</div>
