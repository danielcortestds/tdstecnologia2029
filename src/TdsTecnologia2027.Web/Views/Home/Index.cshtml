					</div>
				</div>

			</div>
		</footer>

	</div>

	@* ===========================================================
	   Modais dos Cursos — alimentados do banco de dados.
	   Renderiza um modal por curso ativo, na mesma ordem dos cards.
	   =========================================================== *@
	@foreach (var curso in Model.CursosPresenciais)
	{
		<div class="te-modal-overlay" id="modal-@curso.Slug">
			<div class="te-modal">
				<button class="te-modal-close" onclick="teCloseModals()">&times;</button>
				@if (!string.IsNullOrWhiteSpace(curso.Categoria))
				{
					<span class="te-modal-tag">@curso.Categoria</span>
				}
				<h2 class="te-modal-title">@curso.Titulo</h2>
				<p class="te-modal-desc">@curso.Descricao</p>
				@{
					var topicos = Bullets(curso.Topicos).ToList();
				}
				@if (topicos.Count > 0)
				{
					<ul class="te-modal-list">
						@foreach (var topico in topicos)
						{
							<li><i class="fa-solid fa-check"></i>@topico</li>
						}
					</ul>
				}
				<div class="te-modal-actions">
					<a href="@LinkWhats(curso.WhatsAppMensagem)" class="btn-bd-primary" target="_blank" rel="noopener" style="flex:1; justify-content:center;"><i class="fa-brands fa-whatsapp"></i> &nbsp;Falar com Especialista</a>
					<button onclick="teCloseModals()" class="btn-bd-outline" style="background:#fff; color:#0f172a;">Fechar</button>
				</div>
			</div>
		</div>
	}

	@* ===========================================================
	   Modais dos cursos ONLINE — módulos, aulas e compra.
	   =========================================================== *@
	@foreach (var curso in Model.CursosOnline)
	{
		var nAulasModal = curso.Modulos.Sum(m => m.Licoes.Count);
		var temDescontoModal = curso.PrecoDe.HasValue && curso.PrecoDe.Value > curso.Preco;
		<div class="te-modal-overlay" id="modal-online-@curso.Id">
			<div class="te-modal">
				<button class="te-modal-close" onclick="teCloseModals()">&times;</button>
				@if (!string.IsNullOrWhiteSpace(curso.Categoria))
				{
					<span class="te-modal-tag">@curso.Categoria</span>
				}
				<h2 class="te-modal-title">@curso.Nome</h2>
				<p class="te-modal-desc">@(string.IsNullOrWhiteSpace(curso.DescricaoCompleta) ? curso.DescricaoCurta : curso.DescricaoCompleta)</p>
				<div class="loja-modal-meta">
					<div class="bd-integration-pill"><i class="bi bi-clock" style="margin-right:4px;"></i>@curso.CargaHoraria h</div>
					@if (nAulasModal > 0)
					{
						<div class="bd-integration-pill"><i class="bi bi-collection-play" style="margin-right:4px;"></i>@curso.Modulos.Count módulos &middot; @nAulasModal aulas</div>
					}
					@if (curso.Certificado)
					{
						<div class="bd-integration-pill"><i class="bi bi-patch-check" style="margin-right:4px;"></i>Certificado</div>
					}
				</div>
				@foreach (var modulo in curso.Modulos)
				{
					<div class="loja-modulo">
						<h5>@modulo.Titulo</h5>
						@if (modulo.Licoes.Any())
						{
							<ul>
								@foreach (var licao in modulo.Licoes)
								{
									<li><i class="bi bi-play-circle"></i>@licao.Titulo@(licao.Duracao > 0 ? $" · {licao.Duracao} min" : "")</li>
								}
							</ul>
						}
					</div>
				}
				<div class="loja-modal-preco">
					@if (temDescontoModal)
					{
						<span class="loja-preco-de">@Moeda(curso.PrecoDe!.Value)</span>
					}
					<span class="loja-preco-atual">@Moeda(curso.Preco)</span>
				</div>
				<div class="te-modal-actions">
					<button type="button" class="btn-bd-primary loja-add" data-id="@curso.Id" style="flex:1; justify-content:center;"><i class="bi bi-cart-plus"></i> &nbsp;Adicionar ao carrinho</button>
					<button onclick="teCloseModals()" class="btn-bd-outline" style="background:#fff; color:#0f172a;">Fechar</button>
				</div>
			</div>
		</div>
	}

	@* ===================== Carrinho (drawer lateral) ===================== *@
	<div class="loja-drawer-overlay" id="lojaDrawerOverlay" onclick="lojaFecharCarrinho()"></div>
	<aside class="loja-drawer" id="lojaDrawer" aria-label="Carrinho de compras">
		<div class="loja-drawer-head">
			<h4><i class="bi bi-cart3" style="margin-right:6px; color:#0d9488;"></i>Seu carrinho</h4>
			<button class="loja-drawer-close" onclick="lojaFecharCarrinho()" aria-label="Fechar">&times;</button>
		</div>
		<div class="loja-drawer-body" id="lojaDrawerBody"></div>
		<div class="loja-drawer-foot">
			<div class="loja-drawer-total"><span>Total</span><strong id="lojaDrawerTotal">R$ 0,00</strong></div>
			<button type="button" class="btn-bd-primary loja-checkout-btn" id="lojaCheckoutBtn" onclick="lojaFinalizar()">Finalizar compra</button>
		</div>
	</aside>
	<div class="loja-toast" id="lojaToast"></div>

	<button id="te-back-top" aria-label="Voltar ao topo" onclick="window.scrollTo({top:0,behavior:'smooth'})">
		<i class="fa-solid fa-chevron-up"></i>
	</button>

	<script>
	function teOpenModal(id) {
		document.getElementById(id).classList.add('is-open');
		document.body.style.overflow = 'hidden';
	}
	function teCloseModals() {
		document.querySelectorAll('.te-modal-overlay').forEach(function(el){ el.classList.remove('is-open'); });
		document.body.style.overflow = '';
	}
	document.addEventListener('keydown', function(e){ if(e.key==='Escape') teCloseModals(); });
	document.querySelectorAll('.te-modal-overlay').forEach(function(o){
		o.addEventListener('click', function(e){ if(e.target===o) teCloseModals(); });
	});
	var _btt = document.getElementById('te-back-top');
	window.addEventListener('scroll', function(){ _btt.classList.toggle('te-visible', window.scrollY > 450); });

	// ===================== Loja / carrinho =====================
	function lojaAbrirCarrinho(){ document.getElementById('lojaDrawer').classList.add('is-open'); document.getElementById('lojaDrawerOverlay').classList.add('is-open'); document.body.style.overflow='hidden'; }
	function lojaFecharCarrinho(){ document.getElementById('lojaDrawer').classList.remove('is-open'); document.getElementById('lojaDrawerOverlay').classList.remove('is-open'); document.body.style.overflow=''; }
	function lojaToast(msg){ var t=document.getElementById('lojaToast'); t.innerHTML='<i class="bi bi-check-circle-fill"></i>'+msg; t.classList.add('is-open'); clearTimeout(window._lojaToastT); window._lojaToastT=setTimeout(function(){t.classList.remove('is-open');},2800); }
	function lojaRender(data){
		var count=document.getElementById('lojaCartCount');
		count.textContent=data.quantidade;
		count.classList.toggle('vazio', data.quantidade===0);
		document.getElementById('lojaDrawerTotal').textContent=data.totalFormatado;
		var body=document.getElementById('lojaDrawerBody');
		var btn=document.getElementById('lojaCheckoutBtn');
		if(!data.itens || data.itens.length===0){
			body.innerHTML='<div class="loja-drawer-empty"><i class="bi bi-cart-x" style="font-size:2rem; display:block; margin-bottom:10px;"></i>Seu carrinho está vazio.</div>';
			btn.style.display='none';
			return;
		}
		btn.style.display='';
		var html='';
		data.itens.forEach(function(it){
			html+='<div class="loja-item">'
				+'<div class="loja-item-ic" style="background:'+it.cor+'"><i class="bi '+it.icone+'"></i></div>'
				+'<div class="loja-item-info"><p class="loja-item-nome">'+it.nome+'</p><span class="loja-item-preco">'+it.precoFormatado+'</span></div>'
				+'<button class="loja-item-rm" title="Remover" onclick="lojaRemover('+it.id+')">&times;</button>'
				+'</div>';
		});
		body.innerHTML=html;
	}
	function lojaPost(url, id, cb){
		var body = (id!=null) ? ('id='+encodeURIComponent(id)) : '';
		fetch(url,{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded','X-Requested-With':'XMLHttpRequest'},body:body})
			.then(function(r){return r.json();}).then(function(d){ lojaRender(d); if(cb) cb(d); })
			.catch(function(){ lojaToast('Erro ao atualizar o carrinho.'); });
	}
	function lojaAdicionar(id){ lojaPost('/Loja/Adicionar', id, function(d){ if(d.ok){ lojaToast('Curso adicionado ao carrinho!'); lojaAbrirCarrinho(); } else { lojaToast(d.mensagem||'Curso indisponível.'); } }); }
	function lojaRemover(id){ lojaPost('/Loja/Remover', id); }
	function lojaFinalizar(){ window.location.href = '/Loja/Checkout'; }
	document.querySelectorAll('.loja-add').forEach(function(b){ b.addEventListener('click', function(){ lojaAdicionar(parseInt(this.getAttribute('data-id'),10)); }); });
	fetch('/Loja/Mini',{headers:{'X-Requested-With':'XMLHttpRequest'}}).then(function(r){return r.json();}).then(lojaRender).catch(function(){});
	</script>

	<script src="~/js/plugins.min.js"></script>
	<script src="~/js/functions.bundle.js"></script>

</body>
</html>
