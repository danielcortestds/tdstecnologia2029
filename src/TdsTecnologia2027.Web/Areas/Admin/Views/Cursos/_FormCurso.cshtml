@model TdsTecnologia2027.Web.Models.Curso

<div asp-validation-summary="ModelOnly" class="alert alert-danger small"></div>

<div class="row g-3 mb-3">
    <div class="col-md-8">
        <label asp-for="Titulo" class="form-label fw-semibold"></label>
        <input asp-for="Titulo" class="form-control" placeholder="Ex: Power BI Essencial" />
        <span asp-validation-for="Titulo" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Slug" class="form-label fw-semibold"></label>
        <input asp-for="Slug" class="form-control" placeholder="ex: powerbi" />
        <div class="form-text">Usado no ID do modal (sem espaços ou acentos).</div>
        <span asp-validation-for="Slug" class="text-danger small"></span>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-6">
        <label asp-for="Categoria" class="form-label fw-semibold"></label>
        <input asp-for="Categoria" class="form-control" placeholder="Ex: Análise de Dados" />
        <span asp-validation-for="Categoria" class="text-danger small"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Icone" class="form-label fw-semibold"></label>
        <input asp-for="Icone" class="form-control" placeholder="ex: fa-solid fa-chart-bar" />
        <div class="form-text">Classes Font Awesome usadas no ícone do card.</div>
        <span asp-validation-for="Icone" class="text-danger small"></span>
    </div>
</div>

<div class="mb-3">
    <label asp-for="DescricaoCurta" class="form-label fw-semibold"></label>
    <textarea asp-for="DescricaoCurta" class="form-control" rows="2" placeholder="Texto que aparece no card da onepage..."></textarea>
    <span asp-validation-for="DescricaoCurta" class="text-danger small"></span>
</div>

<div class="mb-3">
    <label asp-for="Descricao" class="form-label fw-semibold"></label>
    <textarea asp-for="Descricao" class="form-control" rows="4" placeholder="Descrição longa exibida no modal de detalhes..."></textarea>
    <span asp-validation-for="Descricao" class="text-danger small"></span>
</div>

<div class="mb-3">
    <label asp-for="Topicos" class="form-label fw-semibold"></label>
    <textarea asp-for="Topicos" class="form-control" rows="6" placeholder="Um tópico por linha:&#10;Construção de dashboards interativos&#10;Linguagem DAX&#10;Certificado oficial Microsoft"></textarea>
    <div class="form-text">Cada linha vira um item da lista (bullet) no modal do curso.</div>
    <span asp-validation-for="Topicos" class="text-danger small"></span>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-4">
        <label asp-for="CargaHoraria" class="form-label fw-semibold"></label>
        <div class="input-group">
            <input asp-for="CargaHoraria" class="form-control" type="number" min="1" />
            <span class="input-group-text">h</span>
        </div>
        <span asp-validation-for="CargaHoraria" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Preco" class="form-label fw-semibold"></label>
        <div class="input-group">
            <span class="input-group-text">R$</span>
            <input asp-for="Preco" class="form-control" type="number" step="0.01" min="0" />
        </div>
        <span asp-validation-for="Preco" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="DataInicio" class="form-label fw-semibold"></label>
        <input asp-for="DataInicio" class="form-control" type="date" />
        <span asp-validation-for="DataInicio" class="text-danger small"></span>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-6">
        <label asp-for="PillSecundaria" class="form-label fw-semibold"></label>
        <input asp-for="PillSecundaria" class="form-control" placeholder="Ex: 10x sem juros ou In Company" />
        <span asp-validation-for="PillSecundaria" class="text-danger small"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="IconePillSecundaria" class="form-label fw-semibold"></label>
        <input asp-for="IconePillSecundaria" class="form-control" placeholder="ex: fa-solid fa-credit-card" />
        <span asp-validation-for="IconePillSecundaria" class="text-danger small"></span>
    </div>
</div>

<div class="mb-3">
    <label asp-for="ImagemUrl" class="form-label fw-semibold"></label>
    <input asp-for="ImagemUrl" class="form-control" placeholder="https://..." />
    <span asp-validation-for="ImagemUrl" class="text-danger small"></span>
</div>

<div class="mb-3">
    <label asp-for="WhatsAppMensagem" class="form-label fw-semibold"></label>
    <input asp-for="WhatsAppMensagem" class="form-control" placeholder="Ex: Olá, quero saber mais sobre o Power BI Essencial!" />
    <div class="form-text">Texto que vai pré-preenchido no link do WhatsApp.</div>
    <span asp-validation-for="WhatsAppMensagem" class="text-danger small"></span>
</div>

<div class="row g-3 align-items-end mb-4">
    <div class="col-md-3">
        <label asp-for="Ordem" class="form-label fw-semibold"></label>
        <input asp-for="Ordem" class="form-control" type="number" />
        <span asp-validation-for="Ordem" class="text-danger small"></span>
    </div>
    <div class="col-md-9">
        <div class="form-check">
            <input asp-for="Ativo" class="form-check-input" type="checkbox" />
            <label asp-for="Ativo" class="form-check-label">Curso ativo (visível no site)</label>
        </div>
    </div>
</div>
