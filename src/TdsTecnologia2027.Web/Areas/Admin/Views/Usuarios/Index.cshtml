@model List<TdsTecnologia2027.Web.Models.UsuarioListaItem>
@{
    ViewData["Title"] = "Usuários";
    var meuId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="mb-1"><i class="bi bi-people me-2"></i>Usuários do Admin</h3>
        <p class="text-muted mb-0">Quem pode acessar o painel administrativo e o que cada um pode fazer.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-person-plus me-1"></i>Novo usuário
    </a>
</div>

<div class="card shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>E-mail</th>
                    <th>Nível de acesso</th>
                    <th class="text-end">Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model)
                {
                    <tr>
                        <td>
                            <i class="bi bi-person-circle me-1 text-muted"></i>@u.Email
                            @if (u.Id == meuId)
                            {
                                <span class="badge bg-secondary ms-1">você</span>
                            }
                        </td>
                        <td>
                            @if (u.Papel == "Master")
                            {
                                <span class="badge" style="background:#0d9488;">Master — acesso total</span>
                            }
                            else if (u.Papel == "Editor")
                            {
                                <span class="badge bg-info text-dark">Editor — somente cursos</span>
                            }
                            else
                            {
                                <span class="badge bg-light text-muted">@u.Papel</span>
                            }
                        </td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@u.Id" class="btn btn-sm btn-outline-secondary">
                                <i class="bi bi-pencil"></i> Editar
                            </a>
                            @if (u.Id != meuId)
                            {
                                <form asp-action="Delete" asp-route-id="@u.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('Excluir o usuário @u.Email? Esta ação não pode ser desfeita.');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash"></i> Excluir
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
