		<section id="content">
			<div class="content-wrap py-0">

				<section id="features" class="section my-0" style="background:#f8fafc; border-top:1px solid #e2e8f0;">
					<div class="container">

						<div class="row text-center mb-5">
							<div class="col-12">
								<span class="bd-section-label">CURSOS ONLINE</span>
								<h2 class="bd-section-h2 mt-1 mb-3">Aprenda no seu ritmo, com acesso vitalício.</h2>
								<p style="font-family:'Inter',sans-serif; color:#64748b; font-size:1rem; max-width:560px; margin:0 auto; line-height:1.7;">Cursos 100% online, gravados, com certificado. Compre, assista quando quiser e tenha acesso para sempre.</p>
							</div>
						</div>

						@* ===========================================================
						   Cursos ONLINE à venda — vitrine com preço e carrinho.
						   =========================================================== *@
						@if (Model.CursosOnline.Any())
						{
							<div class="row g-4 justify-content-center">
								@foreach (var curso in Model.CursosOnline)
								{
									var corCapa = string.IsNullOrWhiteSpace(curso.CorCapa) ? "#0d9488" : curso.CorCapa;
									var iconeCapa = string.IsNullOrWhiteSpace(curso.IconeCapa) ? "bi-play-circle-fill" : curso.IconeCapa;
									var nAulas = curso.Modulos.Sum(m => m.Licoes.Count);
									var temDesconto = curso.PrecoDe.HasValue && curso.PrecoDe.Value > curso.Preco;

									<div class="col-lg-4 col-md-6">
										<div class="bd-feature-card h-100 d-flex flex-column">
											<div class="bd-feature-icon" style="background:@corCapa;"><i class="bi @iconeCapa" style="color:#fff;"></i></div>
											<h4>@curso.Nome</h4>
											<p>@curso.DescricaoCurta</p>
											<div class="d-flex flex-wrap gap-2 mt-3 mb-3">
												<div class="bd-integration-pill" style="font-size:0.72rem;"><i class="bi bi-clock" style="margin-right:4px;"></i>@curso.CargaHoraria h</div>
												@if (nAulas > 0)
												{
													<div class="bd-integration-pill" style="font-size:0.72rem;"><i class="bi bi-collection-play" style="margin-right:4px;"></i>@nAulas aulas</div>
												}
												@if (curso.Certificado)
												{
													<div class="bd-integration-pill" style="font-size:0.72rem;"><i class="bi bi-patch-check" style="margin-right:4px;"></i>Certificado</div>
												}
											</div>
											<div class="loja-preco mb-3 mt-auto">
												@if (temDesconto)
												{
													<span class="loja-preco-de">@Moeda(curso.PrecoDe!.Value)</span>
												}
												<span class="loja-preco-atual">@Moeda(curso.Preco)</span>
											</div>
											<div class="d-flex align-items-center gap-2">
												<button type="button" onclick="teOpenModal('modal-online-@curso.Id');return false;" class="btn-bd-outline" style="font-size:0.8rem; padding:8px 16px;">Ver módulos</button>
												<button type="button" class="btn-bd-primary loja-add" data-id="@curso.Id" style="font-size:0.8rem; padding:8px 18px;"><i class="bi bi-cart-plus" style="margin-right:5px;"></i>Adicionar</button>
											</div>
										</div>
									</div>
								}
							</div>
						}
						else
						{
							<div class="row justify-content-center">
								<div class="col-lg-7 text-center">
									<p style="color:#94a3b8;">Novos cursos online em breve. <a href="@LinkWhats(null)" target="_blank" rel="noopener" style="color:#0d9488; font-weight:600;">Fale com um consultor</a>.</p>
								</div>
							</div>
						}

						@* ===========================================================
						   Cursos PRESENCIAIS — bloco secundário (turmas fechadas).
						   =========================================================== *@
						@if (Model.CursosPresenciais.Any())
						{
							<div class="row text-center mt-5 pt-5 mb-4" style="border-top:1px solid #e2e8f0;">
								<div class="col-12">
									<span class="bd-section-label">TURMAS PRESENCIAIS E FECHADAS</span>
									<h3 class="bd-section-h2 mt-1 mb-3" style="font-size:1.6rem;">Treinamentos presenciais e in company</h3>
									<p style="font-family:'Inter',sans-serif; color:#64748b; font-size:0.95rem; max-width:540px; margin:0 auto; line-height:1.7;">Turmas presenciais em Mato Grosso e fechadas para empresas, sob demanda. Fale com um consultor para datas e condições.</p>
								</div>
							</div>

							<div class="row g-3 justify-content-center">
								@foreach (var curso in Model.CursosPresenciais)
								{
									var iconeCurso = string.IsNullOrWhiteSpace(curso.Icone) ? "fa-solid fa-graduation-cap" : curso.Icone;
									var dataFormatada = FormatarData(curso.DataInicio);

									<div class="col-lg-4 col-md-6">
										<div class="loja-presencial-card d-flex flex-column">
											<div class="d-flex align-items-center gap-2 mb-2">
												<i class="@iconeCurso" style="color:#0d9488; font-size:1.1rem;"></i>
