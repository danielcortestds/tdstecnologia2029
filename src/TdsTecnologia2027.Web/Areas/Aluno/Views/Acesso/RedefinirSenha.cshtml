@model TdsTecnologia2027.Web.Areas.Aluno.Controllers.RedefinirSenhaAlunoViewModel
@{
    ViewData["Title"] = "Redefinir senha";
    Layout = "_LayoutAcesso";
}

<div class="selo-aluno"><i class="bi bi-mortarboard-fill"></i> Área do Aluno</div>

@if (Model.Concluido)
{
    <h1>Senha alterada!</h1>
    <p class="sub">Sua nova senha já está valendo. Faça login para acessar seus cursos.</p>
    <a href="/Aluno/Entrar" class="btn btn-aluno w-100"><i class="bi bi-box-arrow-in-right me-1"></i>Entrar</a>
}
else
{
    <h1>Criar nova senha</h1>
    <p class="sub">Defina uma nova senha para sua conta de aluno.</p>
    <form method="post">
        <div asp-validation-summary="All" class="text-danger small mb-3"></div>
        <input type="hidden" asp-for="Token" />
        <input type="hidden" asp-for="Email" />
        <div class="mb-3">
            <label asp-for="NovaSenha" class="form-label"></label>
            <input asp-for="NovaSenha" class="form-control" type="password" autofocus />
        </div>
        <div class="mb-3">
            <label asp-for="Confirmar" class="form-label"></label>
            <input asp-for="Confirmar" class="form-control" type="password" />
        </div>
        <button type="submit" class="btn btn-aluno w-100">Salvar nova senha</button>
    </form>
}

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
