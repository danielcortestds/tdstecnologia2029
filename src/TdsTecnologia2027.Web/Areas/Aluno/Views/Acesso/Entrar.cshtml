@model TdsTecnologia2027.Web.Areas.Aluno.Controllers.LoginAlunoViewModel
@{
    ViewData["Title"] = "Entrar";
    Layout = "_LayoutAcesso";
    var returnUrl = ViewData["ReturnUrl"] as string;
}

<div class="selo-aluno"><i class="bi bi-mortarboard-fill"></i> Área do Aluno</div>
<h1>Entrar</h1>
<p class="sub">Acesse seus cursos online da TDS Tecnologia.</p>

<form method="post" asp-route-returnUrl="@returnUrl">
    <div asp-validation-summary="All" class="text-danger small mb-3"></div>

    <div class="mb-3">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" class="form-control" autocomplete="username" autofocus />
    </div>
    <div class="mb-3">
        <label asp-for="Senha" class="form-label"></label>
        <input asp-for="Senha" class="form-control" type="password" autocomplete="current-password" />
    </div>
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div class="form-check">
            <input asp-for="Lembrar" class="form-check-input" />
            <label asp-for="Lembrar" class="form-check-label small"></label>
        </div>
        <a href="/Aluno/EsqueciSenha" class="small">Esqueci minha senha</a>
    </div>
    <button type="submit" class="btn btn-aluno w-100"><i class="bi bi-box-arrow-in-right me-1"></i>Entrar</button>
</form>

<p class="text-center mt-4 mb-0" style="color:#64748b;font-size:.82rem;">
    É administrador? <a href="/Identity/Account/Login">Acesse o painel</a>
</p>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
