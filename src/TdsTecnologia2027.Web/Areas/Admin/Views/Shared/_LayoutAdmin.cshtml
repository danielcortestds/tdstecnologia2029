<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"] — TDS Admin</title>
    <link rel="icon" type="image/png" href="/favicon-32.png?v=2">
    <link rel="icon" href="/favicon.ico?v=2" sizes="any">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        body { background: #f8f9fa; }
        .sidebar { min-height: 100vh; background: #0f172a; }
        .sidebar .nav-link { color: #94a3b8; }
        .sidebar .nav-link:hover, .sidebar .nav-link.active { color: #5eead4; background: rgba(94,234,212,0.08); }
        .sidebar .brand { color: #5eead4; font-weight: 700; font-size: 1.1rem; }
        .sidebar .brand small { display: block; color: #475569; font-size: 0.7rem; font-weight: 400; }
        .main-content { min-height: 100vh; }
        .badge-ativo { background: #d1fae5; color: #065f46; }
        .badge-inativo { background: #fee2e2; color: #991b1b; }
    </style>
</head>
<body>
<div class="container-fluid p-0">
    <div class="row g-0">
        <!-- Sidebar -->
        <nav class="col-md-2 sidebar d-flex flex-column px-3 py-4">
            <a class="brand mb-4 text-decoration-none" href="/Admin/Cursos">
                TDS Tecnologia
                <small>Painel Administrativo</small>
            </a>
            <ul class="nav flex-column gap-1">
                @if (User.IsInRole("Master"))
                {
                    <li class="nav-item">
                        <a class="nav-link rounded @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")"
                           href="/Admin/Dashboard">
                            <i class="bi bi-speedometer2 me-2"></i>Painel
                        </a>
                    </li>
                }
                <li class="nav-item">
                    <a class="nav-link rounded @(ViewContext.RouteData.Values["controller"]?.ToString() == "Cursos" ? "active" : "")"
                       href="/Admin/Cursos">
                        <i class="bi bi-mortarboard me-2"></i>Cursos presenciais
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link rounded @(ViewContext.RouteData.Values["controller"]?.ToString() == "CursosOnline" ? "active" : "")"
                       href="/Admin/CursosOnline">
                        <i class="bi bi-collection-play me-2"></i>Cursos Online
                    </a>
                </li>
                @if (User.IsInRole("Master"))
                {
                    <li class="nav-item">
                        <a class="nav-link rounded @(ViewContext.RouteData.Values["controller"]?.ToString() == "Alunos" ? "active" : "")"
                           href="/Admin/Alunos">
                            <i class="bi bi-person-video3 me-2"></i>Alunos
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link rounded @(ViewContext.RouteData.Values["controller"]?.ToString() == "Usuarios" ? "active" : "")"
                           href="/Admin/Usuarios">
                            <i class="bi bi-people me-2"></i>Usuários
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link rounded @(ViewContext.RouteData.Values["controller"]?.ToString() == "Configuracoes" ? "active" : "")"
                           href="/Admin/Configuracoes">
                            <i class="bi bi-envelope-at me-2"></i>E-mail
                        </a>
                    </li>
                }
            </ul>
            <div class="mt-auto pt-4 border-top border-secondary">
                <form action="/Identity/Account/Logout" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnUrl" value="/" />
                    <button type="submit" class="btn btn-sm btn-outline-secondary w-100 text-start text-muted">
                        <i class="bi bi-box-arrow-right me-2"></i>Sair
                    </button>
                </form>
            </div>
        </nav>

        <!-- Conteúdo principal -->
        <main class="col-md-10 main-content p-4">
            @if (TempData["Sucesso"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle me-2"></i>@TempData["Sucesso"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["Erro"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-circle me-2"></i>@TempData["Erro"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @RenderBody()
        </main>
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
