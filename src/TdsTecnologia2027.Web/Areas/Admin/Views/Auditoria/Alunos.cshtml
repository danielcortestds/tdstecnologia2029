@model List<TdsTecnologia2027.Web.Models.AuditoriaAlunoGeralItem>
@{
    ViewData["Title"] = "Auditoria por aluno";
    Layout = "_LayoutAdmin";
}

<div class="d-flex align-items-center justify-content-between mb-1">
    <h1 class="h3 mb-0"><i class="bi bi-clipboard-data me-2"></i>Auditoria de Progresso</h1>
</div>
<p class="text-muted mb-3">Clique em um aluno para ver os cursos que ele faz, o andamento de cada um e o histórico recente de aulas.</p>

<div class="btn-group mb-4" role="group" aria-label="Modo de auditoria">
    <a href="@Url.Action("Index")" class="btn btn-sm btn-outline-dark"><i class="bi bi-collection-play me-1"></i>Por curso</a>
    <a href="@Url.Action("Alunos")" class="btn btn-sm btn-dark"><i class="bi bi-people me-1"></i>Por aluno</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-light border">Nenhum aluno com matrícula ativa ainda.</div>
}
else
{
    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Aluno</th>
                        <th class="text-center">Cursos</th>
                        <th class="text-center">Aulas concluídas</th>
                        <th style="min-width:200px;">Progresso geral</th>
                        <th>Último acesso</th>
                        <th class="text-end"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in Model)
                    {
                        var url = Url.Action("Perfil", new { alunoId = a.AlunoId });
                        var cor = a.Percentual >= 100 ? "bg-success" : (a.Percentual > 0 ? "bg-info" : "bg-secondary");
                        <tr style="cursor:pointer;" onclick="location.href='@url'">
                            <td>
                                <div class="fw-semibold">@a.Nome</div>
                                @if (!string.IsNullOrWhiteSpace(a.Email))
                                {
                                    <small class="text-muted">@a.Email</small>
                                }
                            </td>
                            <td class="text-center"><span class="badge rounded-pill text-bg-light border">@a.Cursos</span></td>
                            <td class="text-center text-muted">@a.Concluidas / @a.TotalAulas</td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="progress flex-grow-1" style="height:8px; min-width:110px;" role="progressbar" aria-valuenow="@a.Percentual" aria-valuemin="0" aria-valuemax="100">
                                        <div class="progress-bar @cor" style="width:@a.Percentual%"></div>
                                    </div>
                                    <small class="text-muted" style="width:38px;">@a.Percentual%</small>
                                </div>
                            </td>
                            <td>
                                @if (a.UltimoAcesso.HasValue)
                                {
                                    <span class="text-muted small">@a.UltimoAcesso.Value.ToString("dd/MM/yyyy HH:mm")</span>
                                }
                                else
                                {
                                    <span class="text-muted small">—</span>
                                }
                            </td>
                            <td class="text-end">
                                <a href="@url" class="btn btn-sm btn-outline-secondary" onclick="event.stopPropagation();">
                                    Ver perfil <i class="bi bi-arrow-right"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <p class="text-muted small mt-3"><i class="bi bi-info-circle me-1"></i>Progresso geral = aulas concluídas ÷ total de aulas de todos os cursos em que o aluno está matriculado.</p>
}
