@model IEnumerable<TdsTecnologia2027.Web.Models.Curso>
@{
    ViewData["Title"] = "Cursos";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
    var paginaAtual = (int)ViewBag.PaginaAtual;
    var totalPaginas = (int)ViewBag.TotalPaginas;
    var busca = ViewData["Busca"]?.ToString();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="mb-0 fw-bold">Cursos</h4>
        <small class="text-muted">@ViewBag.Total curso(s) encontrado(s)</small>
    </div>
    <a href="/Admin/Cursos/Create" class="btn btn-sm btn-dark">
        <i class="bi bi-plus-lg me-1"></i>Novo Curso
    </a>
</div>

<form method="get" class="mb-3 d-flex gap-2">
    <input type="text" name="busca" value="@busca" class="form-control form-control-sm" placeholder="Buscar por título..." style="max-width:300px;">
    <button type="submit" class="btn btn-sm btn-outline-secondary">Buscar</button>
    @if (!string.IsNullOrWhiteSpace(busca))
    {
        <a href="/Admin/Cursos" class="btn btn-sm btn-outline-danger">Limpar</a>
    }
</form>

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>#</th>
                    <th>Ordem</th>
                    <th>Título</th>
                    <th>Slug</th>
                    <th>Categoria</th>
                    <th>Carga</th>
                    <th>Preço</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="9" class="text-center py-4 text-muted">Nenhum curso encontrado.</td>
                    </tr>
                }
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="text-muted small">@item.Id</td>
                        <td class="text-muted small">@item.Ordem</td>
                        <td class="fw-semibold">@item.Titulo</td>
                        <td><code class="small">@item.Slug</code></td>
                        <td class="small text-muted">@item.Categoria</td>
                        <td>@item.CargaHoraria h</td>
                        <td>R$ @item.Preco.ToString("N2")</td>
                        <td>
                            @if (item.Ativo)
                            {
                                <span class="badge badge-ativo rounded-pill px-3">Ativo</span>
                            }
                            else
                            {
                                <span class="badge badge-inativo rounded-pill px-3">Inativo</span>
                            }
                        </td>
                        <td class="text-end">
                            <a href="/Admin/Cursos/Details/@item.Id" class="btn btn-sm btn-outline-secondary" title="Detalhes"><i class="bi bi-eye"></i></a>
                            <a href="/Admin/Cursos/Edit/@item.Id" class="btn btn-sm btn-outline-primary" title="Editar"><i class="bi bi-pencil"></i></a>
                            <a href="/Admin/Cursos/Delete/@item.Id" class="btn btn-sm btn-outline-danger" title="Desativar"><i class="bi bi-trash"></i></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (totalPaginas > 1)
{
    <nav class="mt-3">
        <ul class="pagination pagination-sm justify-content-center">
            @for (int i = 1; i <= totalPaginas; i++)
            {
                <li class="page-item @(i == paginaAtual ? "active" : "")">
                    <a class="page-link" href="?pagina=@i&busca=@busca">@i</a>
                </li>
            }
        </ul>
    </nav>
}
