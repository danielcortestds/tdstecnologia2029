<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Área do Aluno TDS</title>
    <link rel="icon" type="image/png" href="/favicon-32.png?v=2">
    <link rel="icon" href="/favicon.ico?v=2" sizes="any">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        :root { --tds-teal: #14b8a6; --tds-teal-dark: #0d9488; --tds-navy: #0b1220; --tds-panel: #0f172a; }
        body { background: var(--tds-navy); color: #e2e8f0; font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; min-height: 100vh; }
        a { color: var(--tds-teal); }
        .navbar-aluno { background: #0f172a; border-bottom: 1px solid rgba(148,163,184,0.15); }
        .navbar-aluno .brand img { height: 34px; }
        .navbar-aluno .nav-link { color: #cbd5e1; font-weight: 500; }
        .navbar-aluno .nav-link:hover, .navbar-aluno .nav-link.active { color: var(--tds-teal); }
        .card-tds { background: var(--tds-panel); border: 1px solid rgba(148,163,184,0.14); border-radius: 14px; }
        .btn-tds { background: var(--tds-teal); border: none; color: #04201c; font-weight: 700; }
        .btn-tds:hover { background: var(--tds-teal-dark); color: #fff; }
        .text-muted-2 { color: #94a3b8 !important; }
        .progress { background: #1e293b; }
        .progress-bar { background: var(--tds-teal); }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-aluno py-2">
        <div class="container">
            <a class="navbar-brand brand d-flex align-items-center" asp-area="Aluno" asp-controller="Home" asp-action="Index">
                <img src="~/images/logo-dark.png" alt="TDS Tecnologia" />
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navAluno">
                <span class="navbar-toggler-icon" style="filter:invert(1)"></span>
            </button>
            <div class="collapse navbar-collapse" id="navAluno">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link" asp-area="Aluno" asp-controller="Home" asp-action="Index"><i class="bi bi-grid me-1"></i>Meus Cursos</a>
                    </li>
                </ul>
                <span class="navbar-text text-muted-2 me-3 small d-none d-lg-inline">
                    <i class="bi bi-person-circle me-1"></i>@User.Identity?.Name
                </span>
                <a class="btn btn-sm btn-outline-light me-2" asp-area="Aluno" asp-controller="Conta" asp-action="AlterarSenha">
                    <i class="bi bi-shield-lock me-1"></i>Alterar senha
                </a>
                <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/" method="post" class="d-inline">
                    <button type="submit" class="btn btn-sm btn-outline-light"><i class="bi bi-box-arrow-right me-1"></i>Sair</button>
                </form>
            </div>
        </div>
    </nav>

    <main class="container py-4">
        @RenderBody()
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
