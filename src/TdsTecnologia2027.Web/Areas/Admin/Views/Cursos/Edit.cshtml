@model TdsTecnologia2027.Web.Models.Curso
@{
    ViewData["Title"] = "Editar Curso";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="d-flex align-items-center gap-2 mb-4">
    <a href="/Admin/Cursos" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-left"></i></a>
    <h4 class="mb-0 fw-bold">Editar Curso</h4>
    <span class="text-muted small">#@Model.Id</span>
</div>

<div class="card border-0 shadow-sm" style="max-width:920px;">
    <div class="card-body p-4">
        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="CriadoEm" />

            <partial name="_FormCurso" model="Model" />

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-dark px-4">Salvar Alterações</button>
                <a href="/Admin/Cursos/Details/@Model.Id" class="btn btn-outline-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
