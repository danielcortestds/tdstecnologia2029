@model TdsTecnologia2027.Web.Models.Curso
@{
    ViewData["Title"] = "Desativar Curso";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="d-flex align-items-center gap-2 mb-4">
    <a href="/Admin/Cursos" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-left"></i></a>
    <h4 class="mb-0 fw-bold">Desativar Curso</h4>
</div>

<div class="card border-0 shadow-sm border-danger" style="max-width:600px;">
    <div class="card-body p-4">
        <div class="alert alert-warning d-flex align-items-center gap-2 mb-4">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <div>O curso será <strong>desativado</strong> (soft delete) e não aparecerá mais no site. Você pode reativá-lo editando-o.</div>
        </div>

        <dl class="row">
            <dt class="col-sm-4 text-muted">Título</dt>
            <dd class="col-sm-8 fw-semibold">@Model.Titulo</dd>

            <dt class="col-sm-4 text-muted">Carga Horária</dt>
            <dd class="col-sm-8">@Model.CargaHoraria horas</dd>

            <dt class="col-sm-4 text-muted">Preço</dt>
            <dd class="col-sm-8">R$ @Model.Preco.ToString("N2")</dd>
        </dl>

        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="Id" />
            <div class="d-flex gap-2 mt-3">
                <button type="submit" class="btn btn-danger px-4">
                    <i class="bi bi-trash me-1"></i>Confirmar Desativação
                </button>
                <a href="/Admin/Cursos" class="btn btn-outline-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>
