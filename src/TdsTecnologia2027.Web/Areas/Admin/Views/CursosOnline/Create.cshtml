@model TdsTecnologia2027.Web.Models.CursoOnline
@{ ViewData["Title"] = "Novo curso online"; }

<div class="mb-4">
    <h3 class="mb-1"><i class="bi bi-play-btn me-2"></i>Novo curso online</h3>
    <p class="text-muted mb-0">Depois de criar, você adiciona os módulos e aulas.</p>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body">
        <form asp-action="Create" method="post">
            <partial name="_FormCursoOnline" model="Model" />
            <hr class="my-4" />
            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Criar e adicionar conteúdo</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
        </form>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
