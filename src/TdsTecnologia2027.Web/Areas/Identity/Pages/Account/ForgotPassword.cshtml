@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Esqueci minha senha";
    Layout = "/Areas/Identity/Pages/Account/_LayoutLogin.cshtml";
}

<h1 class="login-title">Esqueci minha senha</h1>

@if (Model.Enviado)
{
    <p class="login-sub" style="margin-bottom:24px;">
        Se houver uma conta com esse e-mail, enviamos um link para você criar uma nova senha.
        Confira sua caixa de entrada (e também o spam).
    </p>
    <a asp-page="./Login" class="btn-tds" style="text-decoration:none; display:inline-block; text-align:center;">
        <i class="bi bi-arrow-left me-1"></i> Voltar ao login
    </a>
}
else
{
    <p class="login-sub" style="margin-bottom:24px;">
        Digite o e-mail da sua conta e enviaremos um link para você criar uma nova senha.
    </p>
    <form method="post">
        <div asp-validation-summary="All" class="alert alert-danger py-2 px-3 mb-3" role="alert"
             style="@(ViewContext.ModelState.IsValid ? "display:none;" : "")"></div>

        <div class="mb-3">
            <label asp-for="Input.Email" class="form-label">E-mail</label>
            <input asp-for="Input.Email" class="form-control" placeholder="seu@email.com" autofocus />
            <span asp-validation-for="Input.Email" class="text-danger"></span>
        </div>

        <button type="submit" class="btn-tds"><i class="bi bi-envelope me-1"></i> Enviar link</button>
    </form>
    <div class="text-center mt-3">
        <a asp-page="./Login" style="color:#0d9488; font-weight:600; text-decoration:none; font-size:0.9rem;">Voltar ao login</a>
    </div>
}
