@model TdsTecnologia2027.Web.Models.CursoOnline
@{ ViewData["Title"] = "Editar curso online"; }

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="mb-1"><i class="bi bi-pencil-square me-2"></i>Editar curso online</h3>
        <p class="text-muted mb-0">@Model.Nome</p>
    </div>
    <a asp-action="Conteudo" asp-route-id="@Model.Id" class="btn btn-outline-primary">
        <i class="bi bi-list-ul me-1"></i>Módulos e aulas
    </a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="CriadoEm" />
            <partial name="_FormCursoOnline" model="Model" />
            <hr class="my-4" />
            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Salvar</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Voltar</a>
        </form>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
