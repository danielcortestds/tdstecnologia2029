@model TdsTecnologia2027.Web.Models.PassHotsiteViewModel
@using System.Globalization
@{
    Layout = null;
    var pt = new CultureInfo("pt-BR");
    var plano = Model.Plano;
    var mensal = (plano.Preco / 10m).ToString("C0", pt);     // R$ 189
    var total = plano.Preco.ToString("C0", pt);               // R$ 1.890
    var parcela = (plano.Preco / 10m).ToString("C", pt);      // R$ 189,00
    var pix = (plano.Preco * 0.9m).ToString("C0", pt);        // R$ 1.701
    var nCursos = Model.Cursos.Count;

    string Icone(TdsTecnologia2027.Web.Models.CursoOnline c) =>
        string.IsNullOrWhiteSpace(c.IconeCapa) ? "bi-play-circle-fill" : c.IconeCapa;
    string Cor(TdsTecnologia2027.Web.Models.CursoOnline c) =>
        string.IsNullOrWhiteSpace(c.CorCapa) ? "#0d9488" : c.CorCapa;
    int Aulas(TdsTecnologia2027.Web.Models.CursoOnline c) => c.Modulos.Sum(m => m.Licoes.Count);
}
<!doctype html>
<html lang="pt-BR">
<head>
    <script>window.dataLayer = window.dataLayer || []; window.dataLayer.push({ hotsite_versao: 'tds-pass-v1' });</script>
    <script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','GTM-55XMGSDF');</script>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#05080c">
    <meta name="description" content="TDS Pass — assinatura anual com acesso a TODOS os cursos online da TDS, inclusive os premium e os novos que entrarem. @mensal/mês.">
    <title>TDS Pass — todos os cursos, um acesso só | TDS Tecnologia</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <style>
        :root{--bg:#05080c;--panel:#0c1118;--line:#1f2832;--ink:#eef2f5;--muted:#95a3b1;--teal:#2dd4bf;--teal-soft:#5eead4;--display:'Manrope',Arial,sans-serif;--body:'DM Sans',Arial,sans-serif}
        *{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--bg);color:var(--ink);font-family:var(--body);line-height:1.6;-webkit-font-smoothing:antialiased}
        a{text-decoration:none;color:inherit}img{max-width:100%;display:block}h1,h2,h3{font-family:var(--display);letter-spacing:-.03em;line-height:1.08;margin:0}
        .wrap{width:min(100% - 8vw,1180px);margin-inline:auto}
        .topline{background:#000;color:#8aa0b2;font:800 .62rem/1 var(--display);letter-spacing:.18em;text-align:center;padding:9px 10px;border-bottom:1px solid var(--line)}
        .topline b{color:var(--teal-soft)}
        header{position:sticky;top:0;z-index:40;background:#05080cd9;backdrop-filter:blur(14px);border-bottom:1px solid var(--line)}
        .hd{display:flex;align-items:center;justify-content:space-between;height:70px}
        .hd img{height:26px;width:auto;filter:brightness(0) invert(1)}
        .btn{display:inline-flex;align-items:center;gap:8px;font:800 .9rem var(--display);padding:13px 24px;border-radius:999px;cursor:pointer;transition:transform .2s,box-shadow .2s}
        .btn-teal{background:var(--teal);color:#06231f;box-shadow:0 10px 30px rgba(45,212,191,.25)}
        .btn-teal:hover{transform:translateY(-2px)}
        .btn-ghost{border:1px solid #33424f;color:var(--ink)}
        .hero{position:relative;padding:clamp(60px,9vw,120px) 0 clamp(50px,7vw,96px);overflow:hidden;background:radial-gradient(1200px 500px at 80% -10%,rgba(45,212,191,.12),transparent 60%),linear-gradient(180deg,#05080c,#0a1017)}
        .eyebrow{display:inline-flex;align-items:center;gap:9px;color:var(--teal-soft);font:800 .74rem var(--display);letter-spacing:.16em;text-transform:uppercase;margin-bottom:22px}
        .eyebrow i{font-size:1rem}
        .hero h1{font-size:clamp(2.9rem,7vw,5.4rem);font-weight:800}
        .hero h1 span{color:var(--teal-soft)}
        .hero p{font-size:1.14rem;color:#cdd7df;max-width:560px;margin:24px 0 30px}
        .hero-actions{display:flex;flex-wrap:wrap;gap:16px;align-items:center}
        .price-pill{display:inline-flex;align-items:baseline;gap:6px;font-family:var(--display)}
        .price-pill b{font-size:1.5rem;font-weight:800}
        .hero-micro{margin-top:22px;color:var(--muted);font-size:.84rem}
        .trust{border-top:1px solid var(--line);border-bottom:1px solid var(--line);background:#070b10}
        .trust-in{display:flex;flex-wrap:wrap;gap:18px 40px;justify-content:center;padding:20px 0;color:#b9c6d1;font-size:.9rem}
        .trust-in span{display:inline-flex;align-items:center;gap:9px}.trust-in i{color:var(--teal)}
        section.block{padding:clamp(56px,8vw,104px) 0}
        .sec-head{text-align:center;max-width:680px;margin:0 auto clamp(34px,5vw,54px)}
        .sec-head h2{font-size:clamp(2.1rem,4.4vw,3.4rem);font-weight:800}
        .sec-head h2 span{color:var(--teal-soft)}
        .sec-head p{color:var(--muted);font-size:1.05rem;margin-top:14px}
        /* Carrossel dinâmico de cursos (marquee) */
        .marquee{position:relative;overflow:hidden;-webkit-mask-image:linear-gradient(90deg,transparent,#000 6%,#000 94%,transparent);mask-image:linear-gradient(90deg,transparent,#000 6%,#000 94%,transparent)}
        .marquee-track{display:flex;gap:16px;width:max-content;animation:marq 48s linear infinite}
        .marquee:hover .marquee-track{animation-play-state:paused}
        @@keyframes marq{from{transform:translateX(0)}to{transform:translateX(-50%)}}
        .course-chip{flex:0 0 auto;width:290px;background:var(--panel);border:1px solid var(--line);border-radius:16px;padding:20px}
        .course-chip .ic{width:46px;height:46px;border-radius:12px;display:grid;place-items:center;color:#fff;font-size:1.3rem;margin-bottom:14px}
        .course-chip h3{font-size:1.05rem;font-weight:800;letter-spacing:-.02em}
        .course-chip p{color:var(--muted);font-size:.82rem;margin:7px 0 12px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;min-height:2.3em}
        .course-chip .meta{display:flex;gap:14px;color:#8da0ae;font-size:.74rem;font-weight:600}
        .course-chip .meta i{color:var(--teal);margin-right:4px}
        .count-note{text-align:center;color:var(--muted);font-size:.9rem;margin-top:22px}
        .count-note b{color:var(--teal-soft)}
        .values{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:18px}
        .value{background:var(--panel);border:1px solid var(--line);border-radius:16px;padding:26px}
        .value i{color:var(--teal);font-size:1.7rem}
        .value h3{font-size:1.1rem;font-weight:800;margin:14px 0 8px}
        .value p{color:var(--muted);font-size:.92rem;margin:0}
        .offer{background:linear-gradient(180deg,#070b10,#05080c)}
        .offer-grid{display:grid;grid-template-columns:1.05fr .95fr;gap:clamp(30px,5vw,70px);align-items:center}
        .offer-copy h2{font-size:clamp(2.1rem,4.4vw,3.6rem);font-weight:800}
        .offer-copy h2 span{color:var(--teal-soft)}
        .offer-copy p{color:#c6d1da;margin:18px 0 0;max-width:460px}
        .pcard{background:#0b1119;border:1px solid var(--line);border-top:4px solid var(--teal);border-radius:20px;padding:30px 30px 34px;box-shadow:0 30px 70px rgba(0,0,0,.5)}
        .pcard .cap{font:800 .68rem var(--display);letter-spacing:.14em;color:var(--muted);display:flex;justify-content:space-between}
        .pcard .big{display:flex;align-items:baseline;gap:8px;margin:18px 0 4px}
        .pcard .big strong{font:800 clamp(3rem,6vw,4.2rem)/1 var(--display);color:#fff}
        .pcard .big span{color:var(--muted);font-size:1.1rem;font-weight:600}
        .pcard .sub{color:var(--muted);font-size:.86rem}
        .pcard ul{list-style:none;padding:0;margin:20px 0 24px;border-top:1px solid var(--line);padding-top:18px}
        .pcard li{display:flex;gap:10px;align-items:flex-start;padding:6px 0;font-size:.92rem;font-weight:500}
        .pcard li i{color:var(--teal);margin-top:2px}
        .pcard .btn{width:100%;justify-content:center}
        .pcard .foot{text-align:center;color:var(--muted);font-size:.74rem;margin:14px 0 0}
        .faq{max-width:760px;margin:0 auto}
        .faq details{border-bottom:1px solid var(--line)}
        .faq summary{list-style:none;cursor:pointer;padding:20px 2px;font:800 1.02rem var(--display);display:flex;justify-content:space-between;gap:16px}
        .faq summary::-webkit-details-marker{display:none}
        .faq summary::after{content:'+';color:var(--teal);font-weight:800}
        .faq details[open] summary::after{content:'–'}
        .faq p{color:var(--muted);margin:-4px 0 20px;font-size:.95rem;max-width:660px}
        footer{border-top:1px solid var(--line);background:#04070a;padding:40px 0 30px}
        .foot-in{display:flex;flex-wrap:wrap;gap:18px;justify-content:space-between;align-items:center;color:var(--muted);font-size:.82rem}
        .foot-back{display:inline-flex;align-items:center;gap:7px;padding:9px 17px;border:1px solid #33424f;border-radius:20px;color:var(--ink);font-weight:700;font-size:.82rem}
        @@media(max-width:820px){.offer-grid{grid-template-columns:1fr}.hd .btn-ghost{display:none}}
        .wa{position:fixed;right:20px;bottom:20px;z-index:60;display:flex;align-items:center;height:58px;max-width:58px;border-radius:30px;background:#25d366;color:#fff;overflow:hidden;box-shadow:0 8px 24px rgba(0,0,0,.35);transition:max-width .35s}
        .wa i{flex:0 0 58px;display:grid;place-items:center;font-size:1.5rem}
        .wa span{white-space:nowrap;font-weight:700;padding-right:22px;opacity:0;transition:opacity .2s}
        .wa:hover{max-width:300px}.wa:hover span{opacity:1}
        @@media(prefers-reduced-motion:reduce){.marquee-track{animation:none}}
    </style>
</head>
<body>
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-55XMGSDF" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>

    <div class="topline">TDS PASS <b>&bull;</b> TODOS OS CURSOS, UM ACESSO SÓ <b>&bull;</b> ASSINATURA ANUAL</div>

    <header>
        <div class="wrap hd">
            <a href="/#features" aria-label="TDS Tecnologia"><img src="/images/logo-dark.png" alt="TDS Tecnologia"></a>
            <div style="display:flex;gap:12px;align-items:center">
                <a class="btn btn-ghost" href="#inclui">O que inclui</a>
                <a class="btn btn-teal" href="/assinar">Assinar &rarr;</a>
            </div>
        </div>
    </header>

    <section class="hero">
        <div class="wrap">
            <div class="eyebrow"><i class="bi bi-infinity"></i> TDS Pass &middot; assinatura anual</div>
            <h1>Todos os cursos.<br><span>Um acesso só.</span></h1>
            <p>Assine o TDS Pass e destrave <strong>todos os cursos online da TDS</strong> — inclusive os premium e os novos que entrarem. Estude no seu ritmo, com certificado.</p>
            <div class="hero-actions">
                <a class="btn btn-teal" href="/assinar"><i class="bi bi-infinity"></i> Assinar · <span class="price-pill"><b>@mensal</b>/mês</span></a>
                <a class="btn btn-ghost" href="#inclui">Ver tudo que inclui</a>
            </div>
            <div class="hero-micro">@nCursos cursos hoje &middot; novos entram automático &middot; certificados inclusos &middot; @plano.DuracaoMeses meses de acesso@(plano.BonusAtivo ? $" (+{plano.BonusMeses} de bônus)" : "")</div>
        </div>
    </section>

    <div class="trust">
        <div class="wrap trust-in">
            <span><i class="bi bi-collection-play-fill"></i> @nCursos cursos incluídos</span>
            <span><i class="bi bi-stars"></i> Premium também (sem exceção)</span>
            <span><i class="bi bi-patch-check-fill"></i> Certificado de conclusão</span>
            <span><i class="bi bi-arrow-repeat"></i> Cursos novos sem pagar a mais</span>
        </div>
    </div>

    <section class="block" id="inclui">
        <div class="wrap sec-head">
            <h2>Tudo isso entra<br><span>no seu Pass.</span></h2>
            <p>Um pagamento, acesso a toda a biblioteca da TDS. Veja o que você destrava na hora:</p>
        </div>
        <div class="marquee">
            <div class="marquee-track">
                @for (var rep = 0; rep < 2; rep++)
                {
                    foreach (var c in Model.Cursos)
                    {
                        <div class="course-chip">
                            <div class="ic" style="background:@Cor(c)"><i class="bi @Icone(c)"></i></div>
                            <h3>@c.Nome</h3>
                            <p>@c.DescricaoCurta</p>
                            <div class="meta">
                                <span><i class="bi bi-clock"></i>@c.CargaHoraria h</span>
                                @{ var a = Aulas(c); }
                                @if (a > 0)
                                {
                                    <span><i class="bi bi-collection-play"></i>@a aulas</span>
                                }
                                @if (c.Certificado)
                                {
                                    <span><i class="bi bi-patch-check"></i>Certificado</span>
                                }
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
        <div class="count-note">E a lista só cresce: <b>todo curso novo entra no Pass automaticamente</b>, sem custo extra.</div>
    </section>

    <section class="block" style="background:#070b10;border-top:1px solid var(--line);border-bottom:1px solid var(--line)">
        <div class="wrap">
            <div class="values">
                <div class="value"><i class="bi bi-stars"></i><h3>Premium incluído</h3><p>Até os cursos mais caros (Mashup, EXIN e os que vierem) entram no Pass — sem pagar à parte.</p></div>
                <div class="value"><i class="bi bi-arrow-repeat"></i><h3>Sempre crescendo</h3><p>Lançou curso novo? Já está no seu acesso, sem renovar nem pagar de novo.</p></div>
                <div class="value"><i class="bi bi-patch-check-fill"></i><h3>Certificados</h3><p>Conclua e emita o certificado de cada curso, normalmente, durante a vigência.</p></div>
                <div class="value"><i class="bi bi-infinity"></i><h3>@plano.MesesTotais() meses de acesso</h3><p>@plano.DuracaoMeses meses@(plano.BonusAtivo ? $" + {plano.BonusMeses} de bônus no lançamento" : "") para estudar no seu ritmo, quando e quantas vezes quiser.</p></div>
            </div>
        </div>
    </section>

    <section class="block offer" id="assinar">
        <div class="wrap offer-grid">
            <div class="offer-copy">
                <div class="eyebrow"><i class="bi bi-infinity"></i> O seu passe</div>
                <h2>Acesso a tudo,<br><span>por @mensal/mês.</span></h2>
                <p>Faça sua inscrição online. Após a aprovação do pagamento, seu acesso a todos os cursos é liberado na Área do Aluno.</p>
            </div>
            <div class="pcard">
                <div class="cap"><span>TDS PASS</span><span>ASSINATURA ANUAL</span></div>
                <div class="big"><strong>@mensal</strong><span>/mês</span></div>
                <div class="sub">em 10&times; de @parcela sem juros &middot; total @total &middot; ou @pix no Pix (10% off)</div>
                <ul>
                    <li><i class="bi bi-check-circle-fill"></i> Acesso a <strong>todos</strong> os @nCursos cursos (e os novos)</li>
                    <li><i class="bi bi-check-circle-fill"></i> Cursos premium inclusos (Mashup, EXIN…)</li>
                    <li><i class="bi bi-check-circle-fill"></i> Certificado de conclusão em cada curso</li>
                    <li><i class="bi bi-check-circle-fill"></i> @plano.MesesTotais() meses de acesso, no seu ritmo</li>
                    <li><i class="bi bi-check-circle-fill"></i> Área do Aluno com seu progresso</li>
                </ul>
                <a class="btn btn-teal" href="/assinar"><i class="bi bi-infinity"></i> Assinar o TDS Pass</a>
                <p class="foot">Pagamento único parcelado (não é mensalidade recorrente). Condições do checkout oficial da TDS prevalecem.</p>
            </div>
        </div>
    </section>

    <section class="block">
        <div class="wrap sec-head"><h2>Perguntas<br><span>frequentes.</span></h2></div>
        <div class="wrap faq">
            <details open><summary>O "@mensal/mês" é uma mensalidade recorrente?</summary><p>Não. É a forma de mostrar o valor: a compra é <strong>única</strong>, parcelada em 10× de @parcela sem juros (total @total), ou @pix no Pix. Não há cobrança automática todo mês.</p></details>
            <details><summary>O que acontece quando o acesso vence?</summary><p>Ao fim do período, o acesso do Pass é encerrado. Você mantém os cursos que comprou avulso (vitalícios) e os certificados já emitidos. É só renovar para voltar a ter tudo.</p></details>
            <details><summary>Cursos novos entram no meu Pass?</summary><p>Sim! Enquanto sua assinatura estiver ativa, todo curso novo publicado entra automaticamente no seu acesso, sem pagar a mais.</p></details>
            <details><summary>Recebo certificado?</summary><p>Sim. Em cada curso concluído você emite o certificado de conclusão da TDS, normalmente, durante a vigência do Pass.</p></details>
            <details><summary>Já comprei um curso avulso. Perco algo?</summary><p>Não. O que você comprou continua seu (vitalício). Ao assinar, você só ganha o acesso a todo o resto e aos cursos novos.</p></details>
        </div>
    </section>

    <footer>
        <div class="wrap foot-in">
            <span>© @DateTime.Now.Year TDS Tecnologia · TDS Pass · Cuiabá · Mato Grosso</span>
            <div style="width:100%;text-align:right"><a class="foot-back" href="/#features">↩ Voltar ao site principal</a></div>
        </div>
    </footer>

    <a class="wa" href="https://wa.me/5565993541604?text=Ol%C3%A1%21%20Quero%20saber%20mais%20sobre%20o%20TDS%20Pass." target="_blank" rel="noopener" aria-label="Fale conosco no WhatsApp">
        <i class="bi bi-whatsapp"></i><span>Dúvidas? Fale conosco</span>
    </a>
</body>
</html>
