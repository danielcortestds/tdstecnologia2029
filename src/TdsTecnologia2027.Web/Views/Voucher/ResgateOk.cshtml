@{
    Layout = "_LayoutLoja";
    ViewData["Title"] = "Voucher resgatado";
}

<div style="text-align:center;">
    <div style="font-size:3rem; color:var(--tds-teal);"><i class="bi bi-check-circle-fill"></i></div>
    <h1 style="font-size:1.5rem; margin:10px 0;">Acesso liberado! 🎉</h1>
    <p class="text-muted-2">
        O curso <strong style="color:#e2e8f0;">@ViewBag.CursoNome</strong> foi liberado para
        <strong style="color:#e2e8f0;">@ViewBag.Email</strong>.
    </p>
    @if (ViewBag.ContaNova == true)
    {
        <p class="text-muted-2">Criamos seu acesso e enviamos um e-mail com o <strong style="color:#e2e8f0;">login e a senha</strong>. Confira sua caixa de entrada (e o spam).</p>
    }
    else
    {
        <p class="text-muted-2">Use o e-mail e a senha que você já tem na plataforma.</p>
    }
    <a href="/Aluno" class="btn btn-tds mt-3" style="max-width:280px; margin:0 auto;"><i class="bi bi-play-circle me-1"></i>Acessar meus cursos</a>
</div>
