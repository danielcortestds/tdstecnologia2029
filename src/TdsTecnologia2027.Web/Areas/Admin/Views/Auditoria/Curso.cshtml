@model TdsTecnologia2027.Web.Models.AuditoriaCursoViewModel
@{
    ViewData["Title"] = $"Auditoria — {Model.CursoNome}";
    Layout = "_LayoutAdmin";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb small">
        <li class="breadcrumb-item"><a href="@Url.Action("Index")">Auditoria</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Model.CursoNome</li>
    </ol>
</nav>

<div class="d-flex align-items-center justify-content-between mb-3">
    <h1 class="h3 mb-0"><i class="bi bi-collection-play me-2"></i>@Model.CursoNome</h1>
    <a href="@Url.Action("Index")" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-left"></i> Voltar aos cursos</a>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm h-100"><div class="card-body py-3">
            <div class="text-muted small">Alunos matriculados</div>
            <div class="h4 mb-0">@Model.Alunos.Count</div>
        </div></div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm h-100"><div class="card-body py-3">
            <div class="text-muted small">Com progresso</div>
            <div class="h4 mb-0">@Model.ComProgresso</div>
        </div></div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm h-100"><div class="card-body py-3">
            <div class="text-muted small">Concluíram 100%</div>
            <div class="h4 mb-0">@Model.Concluintes</div>
        </div></div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm h-100"><div class="card-body py-3">
            <div class="text-muted small">Total de aulas</div>
            <div class="h4 mb-0">@Model.TotalAulas</div>
        </div></div>
    </div>
</div>

@if (!Model.Alunos.Any())
{
    <div class="alert alert-light border">Nenhum aluno matriculado neste curso ainda.</div>
}
else
{
    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Aluno</th>
                        <th class="text-center">Concluídas</th>
                        <th style="min-width:200px;">Progresso</th>
                        <th>Último acesso</th>
                        <th class="text-end"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in Model.Alunos)
                    {
                        var url = Url.Action("Aluno", new { cursoId = Model.CursoId, alunoId = a.AlunoId });
                        var cor = a.Percentual >= 100 ? "bg-success" : (a.Percentual > 0 ? "bg-info" : "bg-secondary");
                        <tr style="cursor:pointer;" onclick="location.href='@url'">
                            <td>
                                <div class="fw-semibold">@a.Nome</div>
                                @if (!string.IsNullOrWhiteSpace(a.Email))
                                {
                                    <small class="text-muted">@a.Email</small>
                                }
                            </td>
                            <td class="text-center"><span class="text-muted">@a.Concluidas / @a.TotalAulas</span></td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="progress flex-grow-1" style="height:8px; min-width:110px;" role="progressbar" aria-valuenow="@a.Percentual" aria-valuemin="0" aria-valuemax="100">
                                        <div class="progress-bar @cor" style="width:@a.Percentual%"></div>
                                    </div>
                                    <small class="text-muted" style="width:38px;">@a.Percentual%</small>
                                </div>
                            </td>
                            <td>
                                @if (a.UltimoAcesso.HasValue)
                                {
                                    <span class="text-muted small">@a.UltimoAcesso.Value.ToString("dd/MM/yyyy HH:mm")</span>
                                }
                                else
                                {
                                    <span class="text-muted small">—</span>
                                }
                            </td>
                            <td class="text-end">
                                <a href="@url" class="btn btn-sm btn-outline-secondary" onclick="event.stopPropagation();">
                                    Ver aulas <i class="bi bi-arrow-right"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
